<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn It, Love It Inc.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes toastIn {
            from { opacity: 0; transform: translateX(100px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes toastOut {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(100px); }
        }
        @keyframes pulse-once {
            0%, 100% { transform: scale(1); }
            50%       { transform: scale(1.08); }
        }

        .animate-slide-in  { animation: slideIn  0.4s ease both; }
        .animate-fade-in   { animation: fadeIn   0.4s ease both; }
        .animate-toast-in  { animation: toastIn  0.35s ease both; }
        .animate-toast-out { animation: toastOut 0.35s ease forwards; }
        .animate-pulse-once { animation: pulse-once 0.3s ease; }

        /* Stagger para los items de la lista */
        li:nth-child(1) { animation-delay: 0.05s; }
        li:nth-child(2) { animation-delay: 0.10s; }
        li:nth-child(3) { animation-delay: 0.15s; }
        li:nth-child(4) { animation-delay: 0.20s; }
        li:nth-child(5) { animation-delay: 0.25s; }
        li:nth-child(n+6) { animation-delay: 0.30s; }

        .progress-bar {
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .item-card:hover .item-actions { opacity: 1; }
        .item-actions { opacity: 0.7; transition: opacity 0.2s; }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-indigo-50 to-purple-50">

    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <div class="max-w-2xl mx-auto px-4 py-12">

        <!-- ── Header ── -->
        <div class="text-center mb-10 animate-slide-in">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 shadow-lg shadow-indigo-200 mb-4">
                <span class="material-icons-round text-white text-4xl">school</span>
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-700 to-purple-600 tracking-tight">
                Learn It, Love It
            </h1>
            <p class="text-gray-500 mt-2 text-sm font-medium">
                Votá por los temas que más querés aprender
            </p>
            <!-- Stats pill -->
            <div class="inline-flex items-center gap-2 mt-4 bg-white border border-indigo-100 rounded-full px-4 py-1.5 shadow-sm text-sm text-indigo-600 font-semibold">
                <span class="material-icons-round text-base text-indigo-400">format_list_numbered</span>
                <span><%= temas.length %> tema<%= temas.length !== 1 ? 's' : '' %> registrado<%= temas.length !== 1 ? 's' : '' %></span>
                &nbsp;·&nbsp;
                <span class="material-icons-round text-base text-purple-400">how_to_vote</span>
                <span><%= temas.reduce((acc, t) => acc + t.votos, 0) %> votos totales</span>
            </div>
        </div>

        <!-- ── Lista de temas ── -->
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl shadow-indigo-100/50 border border-white p-6 mb-5 animate-fade-in">

            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <span class="material-icons-round text-indigo-500 text-xl">menu_book</span>
                    Temas de Aprendizaje
                </h2>
                <% if (temas.length > 0) { %>
                <span class="text-xs text-gray-400 font-medium">ordenado por votos ↓</span>
                <% } %>
            </div>

            <% if (temas.length === 0) { %>
                <!-- Estado vacío -->
                <div class="flex flex-col items-center justify-center py-14 text-center">
                    <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center mb-4">
                        <span class="material-icons-round text-indigo-300 text-3xl">inbox</span>
                    </div>
                    <p class="text-gray-500 font-semibold">Todavía no hay temas</p>
                    <p class="text-gray-400 text-sm mt-1">¡Agregá el primero usando el formulario de abajo!</p>
                </div>
            <% } else { %>
                <%
                    // Ordenar por votos para calcular el máximo (los temas ya vienen del server)
                    const maxVotos = Math.max(...temas.map(t => t.votos), 1);
                    const medals   = ['🥇', '🥈', '🥉'];
                    // Crear copia ordenada por votos para asignar ranking
                    const ranked = [...temas].sort((a, b) => b.votos - a.votos);
                    const rankMap = {};
                    ranked.forEach((t, i) => { if (rankMap[t.id] === undefined) rankMap[t.id] = i; });
                %>
                <ul class="space-y-3">
                    <% temas.forEach((tema) => {
                        const rank = rankMap[tema.id];
                        const medal = medals[rank] || null;
                        const pct   = Math.round((tema.votos / maxVotos) * 100);
                        const isTop = rank < 3 && tema.votos > 0;
                    %>
                    <li class="item-card group flex flex-col p-4 rounded-2xl border transition-all duration-200 cursor-default animate-fade-in
                        <%= isTop && rank === 0 ? 'bg-amber-50   border-amber-200   hover:border-amber-300'   :
                           isTop && rank === 1 ? 'bg-slate-50   border-slate-200   hover:border-slate-300'   :
                           isTop && rank === 2 ? 'bg-orange-50  border-orange-200  hover:border-orange-300'  :
                                                 'bg-gray-50    border-gray-100    hover:bg-indigo-50 hover:border-indigo-200' %>">

                        <div class="flex items-center justify-between gap-3">
                            <!-- Izquierda: medalla/número + título -->
                            <div class="flex items-center gap-3 flex-1 min-w-0">
                                <% if (medal && tema.votos > 0) { %>
                                    <span class="text-xl leading-none flex-shrink-0"><%= medal %></span>
                                <% } else { %>
                                    <span class="text-xs font-bold text-gray-300 w-5 text-right flex-shrink-0"><%= temas.indexOf(tema) + 1 %>.</span>
                                <% } %>
                                <span class="font-semibold text-gray-800 truncate"><%= tema.titulo %></span>
                            </div>

                            <!-- Derecha: badge de votos + botones -->
                            <div class="flex items-center gap-2 flex-shrink-0 item-actions">
                                <span class="hidden sm:inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full
                                    <%= tema.votos > 0 ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-100 text-gray-400' %>">
                                    <span class="material-icons-round text-xs">how_to_vote</span>
                                    <%= tema.votos %>
                                </span>

                                <!-- Votar -->
                                <button
                                    onclick="votarTema(<%= tema.id %>, this)"
                                    class="flex items-center justify-center w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-500 hover:text-white active:scale-95 transition-all duration-150 shadow-sm"
                                    title="Votar">
                                    <span class="material-icons-round text-lg">thumb_up</span>
                                </button>

                                <!-- Eliminar -->
                                <button
                                    onclick="eliminarTema(<%= tema.id %>, this)"
                                    class="flex items-center justify-center w-9 h-9 rounded-xl bg-red-50 text-red-400 hover:bg-red-500 hover:text-white active:scale-95 transition-all duration-150 shadow-sm"
                                    title="Eliminar">
                                    <span class="material-icons-round text-lg">delete</span>
                                </button>
                            </div>
                        </div>

                        <!-- Barra de progreso -->
                        <% if (tema.votos > 0) { %>
                        <div class="mt-3 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                            <div class="progress-bar h-full rounded-full
                                <%= rank === 0 ? 'bg-gradient-to-r from-amber-400 to-yellow-300' :
                                   rank === 1 ? 'bg-gradient-to-r from-slate-400 to-slate-300'  :
                                   rank === 2 ? 'bg-gradient-to-r from-orange-400 to-amber-300' :
                                                'bg-gradient-to-r from-indigo-400 to-purple-400' %>"
                                 style="width: <%= pct %>%">
                            </div>
                        </div>
                        <% } %>
                    </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <!-- ── Formulario ── -->
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl shadow-indigo-100/50 border border-white p-6 animate-fade-in" style="animation-delay:0.15s">
            <h3 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <span class="material-icons-round text-indigo-600 text-base">add</span>
                </span>
                Agregar nuevo tema
            </h3>

            <form action="/temas" method="POST" class="flex gap-3">
                <div class="relative flex-1">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round text-gray-400 text-lg pointer-events-none">edit_note</span>
                    <input
                        type="text"
                        name="titulo"
                        placeholder="Ej: Aprender Node.js, Diseño UX…"
                        required
                        class="w-full border border-gray-200 rounded-2xl pl-10 pr-4 py-3 text-sm text-gray-700 placeholder-gray-400
                               focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100
                               bg-gray-50 hover:bg-white transition-all duration-150"
                    >
                </div>
                <button
                    type="submit"
                    class="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700
                           active:scale-95 text-white font-bold py-3 px-6 rounded-2xl
                           transition-all duration-150 shadow-md shadow-indigo-200 hover:shadow-lg hover:shadow-indigo-200
                           flex items-center gap-2 text-sm whitespace-nowrap"
                >
                    <span class="material-icons-round text-base">add_circle</span>
                    Crear
                </button>
            </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-gray-400 mt-8 font-medium">
            Learn It, Love It Inc. · <%= new Date().getFullYear() %>
        </p>

    </div>

    <script src="/js/script.js"></script>
</body>
</html>
