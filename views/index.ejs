<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn It, Love It Inc.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @keyframes toastIn {
            from { opacity: 0; transform: translateX(100px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes toastOut {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(100px); }
        }
        @keyframes pulse-once {
            0%, 100% { transform: scale(1); }
            50%       { transform: scale(1.08); }
        }

        .animate-slide-in  { animation: slideIn  0.4s ease both; }
        .animate-fade-in   { animation: fadeIn   0.4s ease both; }
        .animate-toast-in  { animation: toastIn  0.35s ease both; }
        .animate-toast-out { animation: toastOut 0.35s ease forwards; }
        .animate-pulse-once { animation: pulse-once 0.3s ease; }

        /* Stagger para los items de la lista */
        li:nth-child(1) { animation-delay: 0.05s; }
        li:nth-child(2) { animation-delay: 0.10s; }
        li:nth-child(3) { animation-delay: 0.15s; }
        li:nth-child(4) { animation-delay: 0.20s; }
        li:nth-child(5) { animation-delay: 0.25s; }
        li:nth-child(n+6) { animation-delay: 0.30s; }

        .progress-bar {
            transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .item-card:hover .item-actions { opacity: 1; }
        .item-actions { opacity: 0.7; transition: opacity 0.2s; }
    </style>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-50 via-indigo-50 to-purple-50">

    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <div class="max-w-2xl mx-auto px-4 py-12">

        <!-- ── Header ── -->
        <div class="text-center mb-10 animate-slide-in">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 shadow-lg shadow-indigo-200 mb-4">
                <span class="material-icons-round text-white text-4xl">school</span>
            </div>
            <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-700 to-purple-600 tracking-tight">
                Learn It, Love It
            </h1>
            <p class="text-gray-500 mt-2 text-sm font-medium">
                Votá por los temas que más querés aprender
            </p>
            <!-- Stats pill -->
            <div class="inline-flex items-center gap-2 mt-4 bg-white border border-indigo-100 rounded-full px-4 py-1.5 shadow-sm text-sm text-indigo-600 font-semibold">
                <span class="material-icons-round text-base text-indigo-400">format_list_numbered</span>
                <span><%= temas.length %> tema<%= temas.length !== 1 ? 's' : '' %> registrado<%= temas.length !== 1 ? 's' : '' %></span>
                &nbsp;·&nbsp;
                <span class="material-icons-round text-base text-purple-400">how_to_vote</span>
                <span><%= temas.reduce((acc, t) => acc + t.votos, 0) %> votos totales</span>
            </div>
        </div>

        <!-- ── Lista de temas ── -->
        <!-- Lista de temas -->
<div class="bg-white rounded-2xl shadow-md p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center gap-2">
        <span class="material-icons-round text-indigo-500">menu_book</span>
        Temas de Aprendizaje
    </h2>

    <% if (temas.length === 0) { %>
        <p class="text-center text-gray-400 py-8">Todavía no hay temas. ¡Agregá el primero!</p>
    <% } else { %>
        <ul class="space-y-4">
            <% temas.forEach((tema, index) => { %>
                <li class="p-4 bg-gray-50 border border-gray-100 rounded-xl hover:border-indigo-200 transition-all duration-200">
                    
                    <!-- Cabecera del Tema -->
                    <div class="flex justify-between items-center gap-4">
                        <div class="flex items-center gap-3 flex-1">
                            <span class="text-xs font-bold text-gray-400 w-5 text-right"><%= index + 1 %>.</span>
                            <span id="tema-display-<%= tema.id %>" class="text-lg text-gray-800"><%= tema.titulo %></span>
                            <form id="tema-form-<%= tema.id %>" class="hidden flex-1">
                                <input
                                    id="tema-input-<%= tema.id %>"
                                    type="text"
                                    value="<%= tema.titulo %>"
                                    class="flex-1 border border-gray-300 rounded-md px-3 py-1.5 text-sm focus:outline-none focus:border-indigo-500"
                                >
                                <button type="button" onclick="guardarTema(<%= tema.id %>)" class="ml-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-3 py-1.5 rounded-md transition">
                                    Guardar
                                </button>
                                <button type="button" onclick="toggleEditarTema(<%= tema.id %>)" class="ml-1 text-gray-500 hover:text-gray-700 text-xs font-bold px-2 py-1.5">
                                    Cancelar
                                </button>
                            </form>
                        </div>
                        
                        <div class="flex items-center gap-2">
                            <span class="bg-indigo-100 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-full whitespace-nowrap flex items-center gap-1">
                                <span class="material-icons-round text-base">how_to_vote</span>
                                <%= tema.votos %> votos
                            </span>
                            
                            <button onclick="toggleEditarTema(<%= tema.id %>)" class="flex items-center justify-center p-2 bg-amber-100 text-amber-600 hover:bg-amber-500 hover:text-white rounded-lg transition-colors cursor-pointer" title="Editar Tema">
                                <span class="material-icons-round text-lg">edit</span>
                            </button>
                            
                            <button onclick="votarTema(<%= tema.id %>)" class="flex items-center justify-center p-2 bg-green-100 text-green-600 hover:bg-green-500 hover:text-white rounded-lg transition-colors cursor-pointer" title="Votar Tema">
                                <span class="material-icons-round text-lg">thumb_up</span>
                            </button>
                            
                            <button onclick="eliminarTema(<%= tema.id %>)" class="flex items-center justify-center p-2 bg-red-100 text-red-600 hover:bg-red-500 hover:text-white rounded-lg transition-colors cursor-pointer" title="Eliminar Tema">
                                <span class="material-icons-round text-lg">delete</span>
                            </button>
                        </div>
                    </div>

                    <!-- Sección de Enlaces -->
                    <div class="mt-4 pl-8 border-t border-gray-200 pt-3">
                        <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Enlaces útiles:</p>
                        
                        <ul class="space-y-2 mb-3">
                            <% if (tema.enlaces && tema.enlaces.length > 0) { %>
                                <% tema.enlaces.forEach(enlace => { %>
                                    <li class="flex justify-between items-center bg-white p-2 px-3 border border-gray-200 rounded-lg text-sm">
                                        <span id="enlace-display-<%= enlace.id %>" class="truncate max-w-xs sm:max-w-md">
                                            <a href="<%= enlace.url %>" target="_blank" class="text-indigo-600 hover:underline truncate"><%= enlace.url %></a>
                                        </span>
                                        <form id="enlace-form-<%= enlace.id %>" class="hidden flex-1">
                                            <input
                                                id="enlace-input-<%= enlace.id %>"
                                                type="url"
                                                value="<%= enlace.url %>"
                                                class="flex-1 border border-gray-300 rounded-md px-2 py-1 text-xs focus:outline-none focus:border-indigo-500"
                                            >
                                            <button type="button" onclick="guardarEnlace(<%= enlace.id %>)" class="ml-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-2 py-1 rounded-md transition">
                                                Guardar
                                            </button>
                                            <button type="button" onclick="toggleEditarEnlace(<%= enlace.id %>)" class="ml-1 text-gray-500 hover:text-gray-700 text-xs font-bold px-2 py-1">
                                                Cancelar
                                            </button>
                                        </form>
                                        
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs text-gray-500 font-semibold"><%= enlace.votos %> votos</span>
                                            <button onclick="toggleEditarEnlace(<%= enlace.id %>)" class="text-amber-600 hover:text-amber-800 p-1" title="Editar Enlace">
                                                <span class="material-icons-round text-sm">edit</span>
                                            </button>
                                            <button onclick="votarEnlace(<%= enlace.id %>)" class="text-green-600 hover:text-green-800 p-1" title="Votar Enlace">
                                                <span class="material-icons-round text-sm">thumb_up</span>
                                            </button>
                                            <button onclick="eliminarEnlace(<%= enlace.id %>)" class="text-red-600 hover:text-red-800 p-1" title="Eliminar Enlace">
                                                <span class="material-icons-round text-sm">delete</span>
                                            </button>
                                        </div>
                                    </li>
                                <% }) %>
                            <% } else { %>
                                <p class="text-xs text-gray-400 italic">No hay enlaces todavía.</p>
                            <% } %>
                        </ul>

                        <!-- Formulario para agregar enlace -->
                        <form onsubmit="agregarEnlace(event, <%= tema.id %>)" class="flex gap-2">
                            <input 
                                id="enlace-nuevo-<%= tema.id %>"
                                type="url" 
                                name="url" 
                                placeholder="https://ejemplo.com" 
                                required
                                class="flex-1 text-xs border border-gray-300 rounded-md px-3 py-1.5 focus:outline-none focus:border-indigo-500"
                            >
                            <button type="submit" class="bg-gray-800 hover:bg-indigo-600 text-white text-xs font-bold px-3 py-1.5 rounded-md transition">
                                Agregar Enlace
                            </button>
                        </form>
                    </div>

                </li>
            <% }) %>
        </ul>
    <% } %>
</div>

        <!-- ── Formulario ── -->
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl shadow-indigo-100/50 border border-white p-6 animate-fade-in" style="animation-delay:0.15s">
            <h3 class="text-base font-bold text-gray-800 mb-4 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <span class="material-icons-round text-indigo-600 text-base">add</span>
                </span>
                Agregar nuevo tema
            </h3>

            <form action="/temas" method="POST" class="flex gap-3">
                <div class="relative flex-1">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 material-icons-round text-gray-400 text-lg pointer-events-none">edit_note</span>
                    <input
                        type="text"
                        name="titulo"
                        placeholder="Ej: Aprender Node.js, Diseño UX…"
                        required
                        class="w-full border border-gray-200 rounded-2xl pl-10 pr-4 py-3 text-sm text-gray-700 placeholder-gray-400
                               focus:outline-none focus:border-indigo-400 focus:ring-2 focus:ring-indigo-100
                               bg-gray-50 hover:bg-white transition-all duration-150"
                    >
                </div>
                <button
                    type="submit"
                    class="bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700
                           active:scale-95 text-white font-bold py-3 px-6 rounded-2xl
                           transition-all duration-150 shadow-md shadow-indigo-200 hover:shadow-lg hover:shadow-indigo-200
                           flex items-center gap-2 text-sm whitespace-nowrap"
                >
                    <span class="material-icons-round text-base">add_circle</span>
                    Crear
                </button>
            </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-gray-400 mt-8 font-medium">
            Learn It, Love It Inc. · <%= new Date().getFullYear() %>
        </p>

    </div>

    <script src="/js/script.js"></script>
</body>
</html>
