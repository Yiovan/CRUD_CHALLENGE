<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn It, Love It Inc.</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="min-h-screen bg-gradient-to-br from-indigo-50 to-purple-50 font-sans">

    <div class="max-w-2xl mx-auto px-4 py-12">

        <!-- Header -->
        <div class="text-center mb-10">
            <span class="material-icons text-6xl text-indigo-400">school</span>
            <h1 class="text-4xl font-extrabold text-indigo-700 mt-3">Learn It, Love It</h1>
            <p class="text-gray-500 mt-1">Votá por los temas que más querés aprender</p>
        </div>

        <!-- Lista de temas -->
        <div class="bg-white rounded-2xl shadow-md p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-700 mb-4 flex items-center gap-2">
                <span class="material-icons text-indigo-500">menu_book</span>
                Temas de Aprendizaje
            </h2>

            <% if (temas.length === 0) { %>
                <p class="text-center text-gray-400 py-8">Todavía no hay temas. ¡Agregá el primero!</p>
            <% } else { %>
                <ul class="space-y-3">
                    <% temas.forEach((tema, index) => { %>
                        <li class="flex justify-between items-center p-4 bg-gray-50 border border-gray-100 rounded-xl hover:bg-indigo-50 hover:border-indigo-200 transition-all duration-200">
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-bold text-gray-400 w-5 text-right"><%= index + 1 %>.</span>
                                <strong class="text-base text-gray-800"><%= tema.titulo %></strong>
                            </div>
                            <span class="bg-indigo-100 text-indigo-700 text-sm font-semibold px-3 py-1 rounded-full whitespace-nowrap flex items-center gap-1">
                                <span class="material-icons text-base">how_to_vote</span>
                                <%= tema.votos %> votos
                            </span>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <!-- Formulario para agregar tema -->
        <div class="bg-white rounded-2xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-700 mb-4 flex items-center gap-2">
                <span class="material-icons text-indigo-500">add_circle</span>
                Agregar un nuevo tema
            </h3>

            <form action="/temas" method="POST" class="flex gap-3">
                <input
                    type="text"
                    name="titulo"
                    placeholder="Ej: Aprender Node.js"
                    required
                    class="flex-1 border border-gray-300 rounded-xl px-4 py-2.5 text-gray-700 placeholder-gray-400 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 transition"
                >
                <button
                    type="submit"
                    class="bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-bold py-2.5 px-6 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md flex items-center gap-2"
                >
                    <span class="material-icons text-base">add</span>
                    Crear
                </button>
            </form>
        </div>

    </div>

</body>
</html>
